{
  "openapi": "3.0.0",
  "info": {
    "title": "SkyMaster",
    "version": "1.0.0-SNAPSHOT"
  },
  "paths": {
    "/handshake": {
      "post": {
        "operationId": "perform",
        "tags": [
          "handshake"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "identity",
                  "version"
                ],
                "properties": {
                  "identity": {
                    "$ref": "#/components/schemas/PlayerIdentity"
                  },
                  "version": {
                    "type": "string",
                    "format": "^\\d+\\.\\d+\\.\\d+(-SNAPSHOT)?$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlayerIdentity": {
        "required": [
          "uuid",
          "username"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "OK"
      },
      "400": {
        "description": "Bad Request"
      },
      "409": {
        "description": "Conflict"
      }
    }
  }
}